{
  "manifest_version": 3,
  "name": "软体猫桌宠",
  "version": "1.0.0",
  "description": "一个可爱的软体猫桌宠，陪伴你的浏览时光",
  "author": "CoryLee1",
  
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "scripting"
  ],
  
  "host_permissions": [
    "<all_urls>"
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "lib/p5.min.js",
        "lib/matter.min.js", 
        "shared/softcat-core.js",
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  
  "action": {
    "default_popup": "popup.html",
    "default_title": "软体猫桌宠",
    "default_icon": {
      "16": "assets/images/cat.png",
      "32": "assets/images/cat.png",
      "48": "assets/images/cat.png",
      "128": "assets/images/cat.png"
    }
  },
  
  "options_page": "options.html",
  
  "icons": {
    "16": "assets/images/cat.png",
    "32": "assets/images/cat.png",
    "48": "assets/images/cat.png",
    "128": "assets/images/cat.png"
  },
  
  "web_accessible_resources": [
    {
      "resources": [
        "assets/images/*",
        "assets/sounds/*",
        "shared/*",
        "lib/*.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}

