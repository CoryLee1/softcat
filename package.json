{
  "name": "softcat-webextension",
  "version": "1.0.0",
  "description": "软体猫桌宠 WebExtension - 一个可爱的浏览器扩展",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\" \"npm run dev:extension\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "dev:extension": "webpack --mode development --watch",
    "build": "npm run build:frontend && npm run build:backend && npm run build:extension",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "build:extension": "webpack --mode production",
    "build:mv3": "node build.js",
    "build:pixi": "npx esbuild src/vendor/pixi-entry.ts --bundle --format=iife --global-name=PIXI --outfile=dist/libs/pixi.iife.js",
    "build:matter": "npx esbuild src/vendor/matter-entry.ts --bundle --format=iife --global-name=Matter --outfile=dist/libs/matter.iife.js",
    "build:content": "npx esbuild src/content.ts --bundle --format=iife --outfile=dist/content.iife.js",
    "package": "npm run build && node scripts/package-extension.js",
    "test": "jest",
    "test:extension": "jest --testPathPattern=extension",
    "lint": "eslint . --ext .js,.ts,.jsx,.tsx",
    "lint:fix": "eslint . --ext .js,.ts,.jsx,.tsx --fix",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "webextension",
    "desktop-pet",
    "soft-body",
    "physics",
    "pixi.js",
    "matter.js",
    "browser-extension"
  ],
  "author": "CoryLee1",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@types/chrome": "^0.0.254",
    "@types/jest": "^29.5.5",
    "@types/node": "^20.6.0",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "babel-loader": "^10.0.0",
    "concurrently": "^8.2.1",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^7.1.2",
    "esbuild": "^0.25.9",
    "eslint": "^8.49.0",
    "jest": "^29.7.0",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.4",
    "typescript": "^5.2.2",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "matter-js": "^0.19.0",
    "p5": "^2.0.5",
    "pixi.js": "^7.4.3"
  },
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
